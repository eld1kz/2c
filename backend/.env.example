DATABASE_URL=postgresql+psycopg://ledgerwise:ledgerwise@localhost:5432/ledgerwise
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Cheaper model for transaction categorization (falls back to LLM_MODEL)
LLM_MODEL_CLASSIFIER=claude-haiku-5-5
# Hard cap on LLM spend per UTC day; chat and categorization stop calling the API once reached
DAILY_LLM_BUDGET_USD=2
# Generate (>= 32 chars, API refuses to boot otherwise):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
DEMO_TODAY=2026-10-01
# development | production (production refuses development defaults: deploy/env.production.example)
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
