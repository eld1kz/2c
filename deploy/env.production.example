# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env ON THE SERVER only
# (gitignored, chmod 600). The backend refuses to boot with development defaults (APP_ENV=production).

# Public hostname (DNS A record → server IP) and the address Let's Encrypt sends expiry notices to.
DOMAIN=demo.example.com
ACME_EMAIL=you@example.com

# Generate each with: python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
JWT_SECRET=

# The separate production key (Anthropic Console workspace with a $50/month spend limit).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MODEL_CLASSIFIER=claude-haiku-5-5
# Hard cap on LLM spend per UTC day; chat and categorization stop calling the API once reached.
DAILY_LLM_BUDGET_USD=5

DEMO_TODAY=2026-10-01
# One-click demo sign-in on the login page (the seeded password, public by design: seed/load.py).
DEMO_PASSWORD=emberoak-demo
# Shown on the login page; must match the reset schedule in deploy/cron/ledgerwise.
DEMO_RESET_EVERY_HOURS=3
